<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="640.0" prefWidth="940.0" styleClass="app-bg" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.streelet.ecg_java_app.StartController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>
    <children>
        <VBox maxWidth="880.0" spacing="22.0" styleClass="card-panel">
            <padding>
                <Insets bottom="28.0" left="32.0" right="32.0" top="26.0" />
            </padding>
            <children>
                <!-- Encabezado -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <Circle radius="6.0" styleClass="brand-dot" />
                        <VBox spacing="1.0">
                            <children>
                                <Label styleClass="app-title" text="ECG Monitor" />
                                <Label styleClass="app-subtitle" text="Configuración de la sesión de monitorización" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_RIGHT" spacing="0.0">
                            <children>
                                <Label fx:id="clockLabel" styleClass="clock" text="10:52" />
                                <Label fx:id="amPmLabel" styleClass="clock-ampm" text="AM" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <Region maxHeight="1.0" minHeight="1.0" prefHeight="1.0" styleClass="divider" />

                <!-- Cuerpo en dos columnas -->
                <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Columna izquierda: paciente -->
                        <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="section-label" text="INFORMACIÓN DEL PACIENTE" />

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Nombre del paciente" />
                                        <TextField fx:id="patientNameTextBox" promptText="Ingrese el nombre del paciente" />
                                    </children>
                                </VBox>

                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="field-label" text="Género" />
                                                <ChoiceBox fx:id="genderComboBox" maxWidth="Infinity" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="field-label" text="Fecha de nacimiento" />
                                                <DatePicker fx:id="birthDatePicker" maxWidth="Infinity" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="field-label" text="Historial médico" />
                                        <TextArea fx:id="medicalHistoryArea" prefHeight="120.0" promptText="Datos relevantes para el monitoreo del paciente" wrapText="true" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- Columna derecha: configuración y acciones -->
                        <VBox minWidth="300.0" prefWidth="300.0" spacing="14.0">
                            <children>
                                <Label styleClass="section-label" text="CONFIGURACIÓN DE ENTRADA" />

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Modo de operación" />
                                        <ChoiceBox fx:id="modeChoiceBox" maxWidth="Infinity" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="field-label" text="Puerto serial" />
                                        <ComboBox fx:id="serialPortComboBox" maxWidth="Infinity" promptText="Seleccione un puerto" />
                                    </children>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS" />

                                <Button fx:id="startButton" maxWidth="Infinity" styleClass="primary-button" text="Iniciar Monitor con Paciente" />
                                <Button fx:id="startWithoutDataButton" maxWidth="Infinity" text="Iniciar Sin Datos de Paciente" />
                                <Button fx:id="exitButton" maxWidth="Infinity" styleClass="exit-button" text="Salir" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
